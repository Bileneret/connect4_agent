# connect4_agent - environment variables (all optional)
#
# The project reads these from the process environment; nothing is loaded
# automatically. Set them in your shell before launching, for example:
#
#     set C4_PLAYER_NAME=MyNick
#     .venv\Scripts\python connect4_agent/run.py --live
#
# This file is a template/documentation, not a runtime config.

# Nickname of our account on the site. The DOM reader uses it to determine
# which side we play (left/right). Default: "Player".
C4_PLAYER_NAME=Player

# Nickname used by tools/opponent_bot.py (the "friend" account for robot
# matches). Default: "PlayerFriend".
C4_FRIEND_NAME=PlayerFriend

# Directory for incident dumps (game-state dumps on anomalies).
# Default: logs/incidents inside the project.
#C4_INCIDENTS_DIR=logs/incidents

# Helper script invoked by tools/acceptance_series.py to show a Windows toast
# between series runs.
# Default: ~/.zcode/skills/windows-push-notification/scripts/send-toast.sh
#C4_TOAST=C:/path/to/send-toast.sh
